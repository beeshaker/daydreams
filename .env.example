# Lead notification email (lib/leads/email.ts) — optional, best-effort.
# Without RESEND_API_KEY set, lead notification emails are skipped (logged instead).
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=hello@daydreamsanddumbbells.com
LEADS_FROM_EMAIL=leads@daydreamsanddumbbells.com

# ElevenLabs Conversational AI voice agent (lib/elevenlabs/client.ts).
# Create an agent in the ElevenLabs dashboard first, then set these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Postgres connection string (lib/db/client.ts). For now this points at a
# hosted Neon free-tier database rather than a database on the VPS — no
# permanent VPS exists yet. Include sslmode=require for Neon.
DATABASE_URL=

# Admin session cookie encryption key (lib/admin/session.ts, iron-session).
# Must be a random string of at least 32 characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Consumed once by `npm run db:seed-admin` (scripts/seed-admin.ts) to create
# the first admin_users row. Safe to unset after the first admin exists —
# further admins are managed via the admin_users table directly.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Number of trusted reverse-proxy hops in front of the app (lib/http/clientIp.ts).
# Only the rightmost N entries of X-Forwarded-For are trusted; earlier entries
# can be spoofed by the client. Leave at 1 behind the current temp VPS's Nginx
# (see docs/deployment.md) — but only trustworthy once that Nginx config is
# confirmed to set X-Real-IP $remote_addr and properly append (not blindly
# pass through) X-Forwarded-For. Set to 0 when running locally with no proxy
# in front at all, so the header isn't trusted from the raw internet.
TRUSTED_PROXY_HOPS=1

# Max accepted request body size (bytes) for POST /api/leads (lib/http/bodyLimit.ts).
LEADS_MAX_BODY_BYTES=20000

# Cloudflare Turnstile bot protection on the lead forms (lib/turnstile/verify.ts,
# components/shared/Turnstile.tsx). Create a Turnstile site in the Cloudflare
# dashboard to get these. If unset, the widget doesn't render and server-side
# verification is skipped (a warning is logged) — safe for local dev, do not
# ship to production without these set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit / daily quota for POST /api/conversation-token (lib/ratelimit/*),
# which mints ElevenLabs conversation tokens and previously had no limit at all.
CONVERSATION_TOKEN_RATE_MAX=3
CONVERSATION_TOKEN_DAILY_QUOTA=200

# Lead retention policy (lib/leads/retention.ts). Unset = the "Purge expired
# leads" admin action and `npm run leads:purge` are disabled. Set once a
# retention period is agreed with the client.
LEAD_RETENTION_DAYS=
