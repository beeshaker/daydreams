# Lead notification email (lib/leads/email.ts) — optional, best-effort.
# Without RESEND_API_KEY set, lead notification emails are skipped (logged instead).
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=hello@daydreamsanddumbbells.com
LEADS_FROM_EMAIL=leads@daydreamsanddumbbells.com

# ElevenLabs Conversational AI voice agent (lib/elevenlabs/client.ts).
# Create an agent in the ElevenLabs dashboard first, then set these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Admin routes (/admin/leads, /admin/kb) — HTTP Basic Auth, checked in proxy.ts.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Class cancellation/reschedule notifications via Meta WhatsApp Cloud API
# (lib/notifications/whatsapp.ts) — optional, best-effort, same graceful
# skip-if-unset behavior as RESEND_API_KEY above. WHATSAPP_TEMPLATE_* names
# must be pre-approved in Meta Business Manager before sends will succeed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_CLASS_CANCELLED=class_cancelled
WHATSAPP_TEMPLATE_CLASS_RESCHEDULED=class_rescheduled
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en_US
